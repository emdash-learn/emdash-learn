{
	"name": "@emdash/lms-core",
	"version": "0.1.0",
	"description": "EmDash course publishing, browser-local progress, knowledge checks, and anonymous engagement reporting.",
	"type": "module",
	"license": "MIT",
	"author": "Emdash Learn contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emdash-learn/emdash-learn.git"
	},
	"homepage": "https://github.com/emdash-learn/emdash-learn#readme",
	"bugs": {
		"url": "https://github.com/emdash-learn/emdash-learn/issues"
	},
	"keywords": [
		"emdash",
		"cms",
		"plugin",
		"lms",
		"learning",
		"courses",
		"assessments"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./sandbox": {
			"types": "./dist/sandbox-entry.d.mts",
			"default": "./dist/sandbox-entry.mjs"
		},
		"./admin": {
			"types": "./dist/admin.d.mts",
			"default": "./dist/admin.mjs"
		},
		"./astro": {
			"types": "./src/astro/index.d.ts",
			"default": "./src/astro/index.ts"
		},
		"./browser": {
			"types": "./dist/browser/index.d.mts",
			"default": "./dist/browser/index.mjs"
		}
	},
	"files": [
		"dist",
		"src/astro",
		"src/browser/device-progress.ts"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm typecheck && pnpm lint && pnpm lint:workflows && pnpm format:check && pnpm test && pnpm build && pnpm lint:package",
		"changeset": "changeset",
		"changeset:status": "changeset status",
		"commitlint": "commitlint",
		"dev": "tsdown --watch",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:policy",
		"test:unit": "vitest run tests/unit --passWithNoTests",
		"test:integration": "vitest run tests/integration --passWithNoTests",
		"test:policy": "node --test scripts/repository-policy.test.mjs",
		"test:e2e": "pnpm build && playwright test",
		"test:watch": "vitest --passWithNoTests",
		"lint": "oxlint --type-aware",
		"lint:package": "publint && attw --pack . --profile esm-only",
		"lint:workflows": "node scripts/lint-workflows.mjs",
		"lint:quick": "oxlint -f json",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepublishOnly": "pnpm check",
		"release:publish": "changeset publish",
		"release:version": "changeset version && pnpm install --lockfile-only",
		"validate:pr-policy": "node scripts/validate-pr-policy.mjs"
	},
	"peerDependencies": {
		"@emdash-cms/blocks": "^0.31.1",
		"astro": "^7.1.3",
		"emdash": "^0.31.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/cli": "^2.31.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@emdash-cms/blocks": "^0.31.1",
		"@playwright/test": "^1.62.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"actionlint": "^2.0.6",
		"astro": "^7.1.3",
		"emdash": "^0.31.1",
		"husky": "^9.1.7",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prettier": "^3.9.6",
		"publint": "^0.3.22",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@10.34.5",
	"pnpm": {
		"overrides": {
			"@modelcontextprotocol/sdk>@hono/node-server": "2.0.12"
		},
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	}
}
