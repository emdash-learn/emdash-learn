{
	"name": "@emdash/lms-core",
	"version": "0.0.0",
	"description": "EmDash course publishing, account-linked progress, knowledge checks, and engagement reporting.",
	"type": "module",
	"license": "MIT",
	"author": "Emdash Learn contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emdash-learn/emdash-learn.git"
	},
	"keywords": [
		"emdash",
		"cms",
		"plugin",
		"lms",
		"learning",
		"courses",
		"assessments"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./sandbox": {
			"types": "./dist/sandbox-entry.d.mts",
			"default": "./dist/sandbox-entry.mjs"
		},
		"./admin": {
			"types": "./dist/admin.d.mts",
			"default": "./dist/admin.mjs"
		},
		"./astro": {
			"types": "./src/astro/index.ts",
			"default": "./src/astro/index.ts"
		},
		"./browser": {
			"types": "./dist/browser/index.d.mts",
			"default": "./dist/browser/index.mjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run test:unit && pnpm run test:integration",
		"test:unit": "vitest run tests/unit --passWithNoTests",
		"test:integration": "vitest run tests/integration --passWithNoTests",
		"test:e2e": "pnpm build && playwright test",
		"test:watch": "vitest --passWithNoTests",
		"lint": "oxlint --type-aware",
		"lint:quick": "oxlint -f json",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepublishOnly": "pnpm typecheck && pnpm build",
		"publish:npm": "npm publish --access public"
	},
	"peerDependencies": {
		"@emdash-cms/blocks": "^0.31.1",
		"astro": "^6.0.0",
		"emdash": "^0.32.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.0",
		"@emdash-cms/blocks": "^0.31.1",
		"@playwright/test": "^1.58.0",
		"@types/node": "^24.10.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"astro": "^6.0.1",
		"emdash": "^0.31.1",
		"oxlint": "^1.49.0",
		"oxlint-tsgolint": "^0.21.1",
		"prettier": "^3.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@10.28.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	}
}
