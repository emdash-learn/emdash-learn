---
import { callLmsRoute } from "../../lib/lms-api.ts";

interface QuestionForStudent {
	id: string;
	type: "mcq" | "multi" | "true_false" | "short_text";
	prompt: string;
	points: number;
	options?: Array<{ id: string; text: string }>;
}

interface StartAttemptResult {
	attemptId: string;
	questions: QuestionForStudent[];
	startedAt: string;
	timeLimit?: number;
	timeLimitPolicy: "hard" | "soft";
}

const { quizId } = Astro.params;
const lessonId = Astro.url.searchParams.get("lessonId") ?? undefined;
const back = Astro.url.searchParams.get("back") ?? "/my-learning";
const cookie = Astro.request.headers.get("cookie");
const origin = Astro.url.origin;

const startInput: Record<string, unknown> = { quizId };
if (lessonId) startInput.lessonId = lessonId;

const startResult = await callLmsRoute<StartAttemptResult>(
	"quiz:start",
	startInput,
	{ cookie, origin },
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Quiz — Emdash Learn demo</title>
		<style>
			body { font-family: system-ui, sans-serif; max-width: 48rem; margin: 2rem auto; padding: 0 1rem; color: #111; }
			a { color: #1a4fff; }
			fieldset { border: 1px solid #e5e5e5; border-radius: 6px; padding: 0.75rem 1rem; margin-block-end: 1rem; }
			legend { font-weight: 600; padding-inline: 0.25rem; }
			label { display: block; padding-block: 0.2rem; }
			button.submit { background: #1a4fff; color: white; border: 0; padding: 0.6rem 1.1rem; border-radius: 6px; font-size: 1rem; cursor: pointer; }
			button.submit[disabled] { opacity: 0.5; cursor: not-allowed; }
			.result { border-radius: 6px; padding: 0.75rem 1rem; margin-block: 1rem; }
			.result.pass { background: #dfe; color: #153; }
			.result.fail { background: #fee; color: #733; }
			.meta { color: #666; font-size: 0.9rem; }
			.error { color: #a33; }
		</style>
	</head>
	<body>
		<nav><a href={back}>← Back</a></nav>
		<h1>Quiz</h1>
		{!startResult.ok && (
			<p class="error" data-testid="quiz-error">
				Couldn't start quiz: {startResult.error?.message ?? "unknown error"}
			</p>
		)}
		{startResult.ok && startResult.data && (
			<>
				<p class="meta">
					{startResult.data.questions.length} questions.
					{startResult.data.timeLimit && (
						<> Time limit: {Math.round(startResult.data.timeLimit / 60)} min.</>
					)}
				</p>
				<form id="quiz-form" data-attempt-id={startResult.data.attemptId}>
					{startResult.data.questions.map((q) => (
						<fieldset data-q-id={q.id} data-q-type={q.type}>
							<legend>{q.prompt}</legend>
							{(q.type === "mcq" || q.type === "multi") && q.options && q.options.map((opt) => (
								<label>
									<input
										type={q.type === "multi" ? "checkbox" : "radio"}
										name={q.id}
										value={opt.id}
									/>
									{" "}{opt.text}
								</label>
							))}
							{q.type === "true_false" && (
								<>
									<label><input type="radio" name={q.id} value="true" /> True</label>
									<label><input type="radio" name={q.id} value="false" /> False</label>
								</>
							)}
							{q.type === "short_text" && (
								<input type="text" name={q.id} style="width: 100%; padding: 0.4rem;" />
							)}
						</fieldset>
					))}
					<button class="submit" type="submit" data-testid="quiz-submit">
						Submit
					</button>
				</form>
				<div id="quiz-result" hidden></div>
			</>
		)}

		<script is:inline>
			const form = document.getElementById("quiz-form");
			if (form) {
				form.addEventListener("submit", async (e) => {
					e.preventDefault();
					const button = form.querySelector("button[type='submit']");
					if (button) {
						button.setAttribute("disabled", "true");
						button.textContent = "Submitting…";
					}
					const answers = [];
					for (const fieldset of form.querySelectorAll("fieldset")) {
						const qId = fieldset.getAttribute("data-q-id");
						const type = fieldset.getAttribute("data-q-type");
						if (type === "multi") {
							const checked = [...fieldset.querySelectorAll("input[type='checkbox']:checked")]
								.map((el) => el.value);
							answers.push({ questionId: qId, answer: checked });
						} else if (type === "true_false") {
							const picked = fieldset.querySelector("input[type='radio']:checked");
							answers.push({ questionId: qId, answer: picked ? picked.value === "true" : null });
						} else if (type === "short_text") {
							const input = fieldset.querySelector("input[type='text']");
							answers.push({ questionId: qId, answer: input ? input.value : "" });
						} else {
							const picked = fieldset.querySelector("input[type='radio']:checked");
							answers.push({ questionId: qId, answer: picked ? picked.value : "" });
						}
					}
					try {
						const res = await fetch("/_emdash/api/plugins/lms-core/quiz:submit", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-EmDash-Request": "1",
							},
							credentials: "same-origin",
							body: JSON.stringify({
								attemptId: form.getAttribute("data-attempt-id"),
								answers,
							}),
						});
						const body = await res.json();
						if (!res.ok) {
							throw new Error(body && body.error ? body.error.message : `HTTP ${res.status}`);
						}
						const result = body.data;
						const banner = document.getElementById("quiz-result");
						banner.hidden = false;
						banner.className = "result " + (result.passed ? "pass" : "fail");
						banner.setAttribute("data-testid", "quiz-result");
						banner.setAttribute("data-passed", String(result.passed));
						banner.innerHTML = result.passed
							? `<strong>Passed</strong> — score ${result.score}`
							: `<strong>Did not pass</strong> — score ${result.score}. <a href="${window.location.pathname}${window.location.search}">Try again</a>`;
						if (button) {
							button.setAttribute("disabled", "true");
							button.textContent = result.passed ? "Submitted" : "Submitted — retry below";
						}
					} catch (err) {
						if (button) {
							button.removeAttribute("disabled");
							button.textContent = "Submit";
						}
						alert("Submit failed: " + (err && err.message ? err.message : err));
					}
				});
			}
		</script>
	</body>
</html>
