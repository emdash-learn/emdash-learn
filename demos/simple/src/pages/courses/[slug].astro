---
import { callLmsRoute, portableTextParagraphs } from "../../lib/lms-api.ts";

interface PublishedCourse {
	id: string;
	slug: string | null;
	title: string;
	subtitle?: string;
	description?: string;
	body?: unknown;
	difficulty?: "beginner" | "intermediate" | "advanced";
	estimatedHours?: number;
}

interface PublishedLessonSummary {
	id: string;
	slug: string | null;
	title: string;
	order: number;
	summary?: string;
	durationSeconds?: number;
}

interface CourseDetail {
	course: PublishedCourse;
	lessons: PublishedLessonSummary[];
}

const slug = Astro.params.slug ?? "";
const result = await callLmsRoute<CourseDetail>(
	"course:get",
	{ slug },
	{ origin: Astro.url.origin },
);

if (!result.ok || !result.data) {
	return new Response("Published course not found", {
		status: result.error?.status === 404 ? 404 : 500,
	});
}

const { course, lessons } = result.data;
const body = portableTextParagraphs(course.body);

function durationLabel(seconds: number | undefined): string | undefined {
	if (seconds === undefined) return undefined;
	const minutes = Math.max(1, Math.round(seconds / 60));
	return `${minutes} min`;
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{course.title} — EmDash Learn demo</title>
		<style>
			body { font-family: system-ui, sans-serif; max-width: 58rem; margin: 2rem auto; padding: 0 1rem; color: #172033; line-height: 1.6; }
			a { color: #3047d8; }
			header { border-bottom: 1px solid #dce1eb; padding-bottom: 1.5rem; }
			h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.08; margin-bottom: 0.5rem; }
			.subtitle { font-size: 1.15rem; color: #4d5b72; }
			.badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; background: #edf0ff; color: #2d3a78; margin-right: 0.3rem; font-size: 0.85rem; }
			.lessons { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
			.lesson { border: 1px solid #dce1eb; border-radius: 0.65rem; padding: 1rem 1.15rem; }
			.lesson a { font-weight: 700; }
			.meta { color: #667085; font-size: 0.9rem; }
		</style>
	</head>
	<body>
		<nav><a href="/catalog">← Published courses</a></nav>
			<main data-course-detail data-course-id={course.id}>
			<header>
				<h1>{course.title}</h1>
				{course.subtitle && <p class="subtitle">{course.subtitle}</p>}
				<p>
					{course.difficulty && <span class="badge">{course.difficulty}</span>}
					{course.estimatedHours !== undefined && (
						<span class="badge">{course.estimatedHours} hours</span>
					)}
				</p>
				{course.description && <p>{course.description}</p>}
				{body.map((paragraph) => <p>{paragraph}</p>)}
			</header>

			<section>
				<h2>Lessons</h2>
				{lessons.length === 0 ? (
					<p>No published lessons yet.</p>
				) : (
					<ol class="lessons" data-testid="published-lessons">
						{lessons.map((lesson) => (
							<li class="lesson" data-lesson-id={lesson.id}>
								<a
									href={`/courses/${course.slug}/lessons/${lesson.id}`}
									data-testid="lesson-link"
								>
									{lesson.order}. {lesson.title}
								</a>
								{lesson.summary && <p>{lesson.summary}</p>}
								{durationLabel(lesson.durationSeconds) && (
									<p class="meta">{durationLabel(lesson.durationSeconds)}</p>
								)}
							</li>
						))}
					</ol>
				)}
				</section>
			</main>
			<script>
				import { createLearnBrowserClient } from "@emdashlms/plugin/browser";

				const courseRoot = document.querySelector<HTMLElement>("[data-course-detail]");
				const courseId = courseRoot?.dataset.courseId;
				if (courseRoot && courseId && courseRoot.dataset.openObserved !== "true") {
					courseRoot.dataset.openObserved = "true";
					const learn = createLearnBrowserClient({ storage: window.localStorage });
					void learn.observeCourseOpened(courseId);
				}
			</script>
		</body>
	</html>
