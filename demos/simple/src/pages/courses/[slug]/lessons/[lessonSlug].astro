---
import { KnowledgeCheckBlock } from "@emdash/lms-core/astro";
import { callLmsRoute, portableTextParagraphs } from "../../../../lib/lms-api.ts";

interface LessonSummary {
	id: string;
	title: string;
	order: number;
}

interface CourseDetail {
	course: { id: string; slug: string | null; title: string };
	lessons: LessonSummary[];
}

interface PublishedLesson {
	id: string;
	courseId: string;
	title: string;
	summary?: string;
	body?: unknown;
	videoUrl?: string;
	durationSeconds?: number;
}

type PortableBlock = {
	_type: "learnKnowledgeCheck";
	courseId: string;
	checkId: string;
};

function isKnowledgeCheckBlock(value: unknown): value is PortableBlock {
	if (typeof value !== "object" || value === null) return false;
	return (
		Reflect.get(value, "_type") === "learnKnowledgeCheck" &&
		typeof Reflect.get(value, "courseId") === "string" &&
		typeof Reflect.get(value, "checkId") === "string"
	);
}

const courseSlug = Astro.params.slug ?? "";
const lessonId = Astro.params.lessonSlug ?? "";
const [courseResult, lessonResult] = await Promise.all([
	callLmsRoute<CourseDetail>("course:get", { slug: courseSlug }, { origin: Astro.url.origin }),
	callLmsRoute<{ lesson: PublishedLesson }>(
		"lesson:get",
		{ lessonId },
		{ origin: Astro.url.origin },
	),
]);

if (!courseResult.ok || !courseResult.data || !lessonResult.ok || !lessonResult.data?.lesson) {
	return new Response("Published lesson not found", { status: 404 });
}

const { course, lessons } = courseResult.data;
const lesson = lessonResult.data.lesson;
if (lesson.courseId !== course.id || !lessons.some((item) => item.id === lesson.id)) {
	return new Response("Published lesson not found", { status: 404 });
}

const body = Array.isArray(lesson.body) ? lesson.body : [];
const paragraphs = portableTextParagraphs(body);
const checkBlock = body.find(isKnowledgeCheckBlock);
const knowledgeCheckBlock =
	checkBlock?.courseId === course.id ? checkBlock : undefined;

const currentIndex = lessons.findIndex((item) => item.id === lesson.id);
const previous = currentIndex > 0 ? lessons[currentIndex - 1] : undefined;
const next =
	currentIndex >= 0 && currentIndex < lessons.length - 1
		? lessons[currentIndex + 1]
		: undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{lesson.title} — {course.title}</title>
		<style>
			body { font-family: system-ui, sans-serif; max-width: 50rem; margin: 2rem auto; padding: 0 1rem; color: #172033; line-height: 1.65; }
			a { color: #3047d8; }
			h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; }
			.summary { color: #59657a; font-size: 1.1rem; }
			.lesson-body { margin-block: 2rem; }
			.device-progress { margin-top: 2rem; border: 1px solid #ccd2e0; border-radius: 0.75rem; padding: 1.25rem; }
			.device-progress h2 { margin-top: 0; }
			.device-note { color: #59657a; }
			button { margin-top: 1.25rem; border: 0; border-radius: 0.45rem; background: #3047d8; color: white; font: inherit; font-weight: 700; padding: 0.65rem 1rem; cursor: pointer; }
			button[disabled] { opacity: 0.65; cursor: wait; }
			.lesson-nav { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid #dce1eb; margin-top: 2.5rem; padding-top: 1rem; }
		</style>
	</head>
	<body>
		<nav><a href={`/courses/${course.slug}`}>← {course.title}</a></nav>
		<main>
			<h1>{lesson.title}</h1>
			{lesson.summary && <p class="summary">{lesson.summary}</p>}
			<div class="lesson-body" data-testid="lesson-body">
					{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>

				<section
					class="device-progress"
					data-device-progress
					data-course-id={course.id}
					data-lesson-id={lesson.id}
					data-testid="device-progress"
				>
					<h2>Device progress</h2>
					<p data-device-progress-status aria-live="polite">
						Loading device progress…
					</p>
					<button type="button" data-device-complete>Mark lesson complete</button>
					<p class="device-note">
						Stored in this browser only. This is not an EmDash account learning record.
					</p>
				</section>

				{knowledgeCheckBlock && <KnowledgeCheckBlock node={knowledgeCheckBlock} />}

			<nav class="lesson-nav" aria-label="Lesson navigation">
				<span>
					{previous && (
						<a href={`/courses/${course.slug}/lessons/${previous.id}`}>
							← {previous.title}
						</a>
					)}
				</span>
				<span>
					{next && (
						<a href={`/courses/${course.slug}/lessons/${next.id}`}>
							{next.title} →
						</a>
					)}
				</span>
			</nav>
		</main>

			<script>
				import { createLearnBrowserClient } from "@emdash/lms-core/browser";

				const learn = createLearnBrowserClient({ storage: window.localStorage });
				const progressRoot = document.querySelector<HTMLElement>("[data-device-progress]");
				const progressStatus = progressRoot?.querySelector<HTMLElement>(
					"[data-device-progress-status]",
				);
				const progressNote = progressRoot?.querySelector<HTMLElement>(".device-note");
				const completeButton = progressRoot?.querySelector<HTMLButtonElement>(
					"[data-device-complete]",
				);

				function showDeviceCompletion(): void {
					if (!progressStatus || !progressNote || !completeButton) return;
					progressStatus.textContent = "Completed on this device.";
					progressNote.textContent =
						"Stored in this browser only. This is not an EmDash account learning record.";
					completeButton.textContent = "Completed on this device";
					completeButton.disabled = true;
				}

					if (progressRoot && progressStatus && progressNote && completeButton) {
						const courseId = progressRoot.dataset.courseId ?? "";
						const lessonId = progressRoot.dataset.lessonId ?? "";
						if (courseId && lessonId && progressRoot.dataset.openObserved !== "true") {
							progressRoot.dataset.openObserved = "true";
							void learn.observeLessonOpened({ courseId, lessonId });
						}
						const progress = learn.deviceProgress.getCourse(courseId);
					if (progress?.completedLessonIds.includes(lessonId)) {
						showDeviceCompletion();
					} else {
						progressStatus.textContent = "Not completed on this device.";
						completeButton.addEventListener("click", () => {
							completeButton.disabled = true;
							progressStatus.textContent = "Saving completion…";
							void learn
								.completeLesson({ courseId, lessonId })
								.then(() => showDeviceCompletion())
								.catch((error: unknown) => {
									progressStatus.textContent =
										error instanceof Error
											? error.message
											: "Completion could not be saved.";
									completeButton.disabled = false;
								});
						});
					}
				}

			</script>
	</body>
</html>
