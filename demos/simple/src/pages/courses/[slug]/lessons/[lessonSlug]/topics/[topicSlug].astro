---
// Topic page (ADR 0001). [topicSlug] is the topic content id; the demo
// builds URLs from the curriculum response, which exposes ids not slugs.

import { callLmsRoute, escapeHtml } from "../../../../../../lib/lms-api.ts";

interface VisibleTopic {
	id: string;
	title: string;
	order: number;
	summary?: string;
	requiresPrevious: boolean;
	unlocked: boolean;
	completed: boolean;
	percentComplete: number;
	videoUrl?: string;
	durationSeconds?: number;
}

interface VisibleLesson {
	id: string;
	title: string;
	topics: VisibleTopic[];
}

interface TopicDoc {
	id: string;
	slug?: string;
	data: Record<string, unknown>;
}

interface CatalogCourse {
	id: string;
	slug?: string;
	title: string;
}

const { slug, lessonSlug, topicSlug } = Astro.params;
const lessonId = lessonSlug ?? "";
const topicId = topicSlug ?? "";
const cookie = Astro.request.headers.get("cookie");
const origin = Astro.url.origin;

const catalog = await callLmsRoute<{ items: CatalogCourse[] }>(
	"catalog",
	{ limit: 100 },
	{ cookie, origin },
);
const course = catalog.ok
	? (catalog.data?.items ?? []).find((c) => c.slug === slug)
	: undefined;
if (!course) return new Response("Course not found", { status: 404 });

const curriculumResult = await callLmsRoute<{ items: VisibleLesson[] }>(
	"curriculum",
	{ courseId: course.id },
	{ cookie, origin },
);
const curriculum: VisibleLesson[] = curriculumResult.ok
	? (curriculumResult.data?.items ?? [])
	: [];
const lesson = curriculum.find((l) => l.id === lessonId);
const siblingTopics: VisibleTopic[] = lesson?.topics ?? [];
const topicIdx = siblingTopics.findIndex((t) => t.id === topicId);
const prevTopic = topicIdx > 0 ? siblingTopics[topicIdx - 1] : undefined;
const nextTopic =
	topicIdx >= 0 && topicIdx < siblingTopics.length - 1
		? siblingTopics[topicIdx + 1]
		: undefined;

const topicResult = await callLmsRoute<{ topic: TopicDoc }>(
	"topic",
	{ topicId },
	{ cookie, origin },
);

if (!topicResult.ok) {
	const status =
		topicResult.error?.status && topicResult.error.status >= 400 && topicResult.error.status < 600
			? topicResult.error.status
			: 500;
	return new Response(
		`Couldn't load topic: ${topicResult.error?.message ?? "unknown error"}`,
		{ status },
	);
}

const topic = topicResult.data?.topic;
const data = (topic?.data ?? {}) as Record<string, unknown>;
const videoUrl = typeof data["video_url"] === "string" ? (data["video_url"] as string) : undefined;
const summary = typeof data["summary"] === "string" ? (data["summary"] as string) : undefined;
const body = Array.isArray(data["body"]) ? (data["body"] as Array<{ _type: string; children?: any[] }>) : [];
const topicTitle = typeof data["title"] === "string" ? (data["title"] as string) : "Topic";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{topicTitle} — {lesson?.title ?? "Lesson"} — {course.title}</title>
		<style>
			body { font-family: system-ui, sans-serif; max-width: 56rem; margin: 2rem auto; padding: 0 1rem; color: #111; }
			a { color: #1a4fff; }
			.video { margin-block: 1rem; }
			.video video { width: 100%; max-height: 420px; border-radius: 6px; background: #000; }
			button.complete { background: #1a4fff; color: white; border: 0; padding: 0.5rem 1rem; border-radius: 6px; font-size: 1rem; cursor: pointer; }
			button.complete[disabled] { opacity: 0.5; cursor: not-allowed; }
			button.complete.done { background: #163; }
			.nav { display: flex; justify-content: space-between; margin-block: 1.5rem; }
			.meta { color: #666; font-size: 0.9rem; }
		</style>
	</head>
	<body>
		<nav>
			<a href={`/courses/${course.slug}/lessons/${lessonId}`}>
				← {lesson?.title ?? "Lesson"}
			</a>
		</nav>
		<h1>{topicTitle}</h1>
		{summary && <p class="meta">{summary}</p>}

		{videoUrl && (
			<div class="video">
				<video
					controls
					preload="metadata"
					src={videoUrl}
					data-topic-id={topicId}
					data-testid="topic-video"
				></video>
			</div>
		)}

		{body.length > 0 && (
			<div class="topic-body">
				{body
					.filter((b) => b && b._type === "block" && Array.isArray(b.children))
					.map((b) => (
						<p set:html={escapeHtml(
							((b.children ?? []) as any[])
								.filter((c) => typeof c?.text === "string")
								.map((c) => c.text)
								.join(""),
						)}></p>
					))}
			</div>
		)}

		<button
			class="complete"
			data-testid="topic-complete-btn"
			data-topic-id={topicId}
		>
			Mark topic complete
		</button>

		<div class="nav">
			<div>
				{prevTopic && (
					<a href={`/courses/${course.slug}/lessons/${lessonId}/topics/${prevTopic.id}`}>
						← {prevTopic.title}
					</a>
				)}
			</div>
			<div>
				{nextTopic && (
					<a href={`/courses/${course.slug}/lessons/${lessonId}/topics/${nextTopic.id}`}>
						{nextTopic.title} →
					</a>
				)}
			</div>
		</div>

		<script is:inline>
			const video = document.querySelector("[data-testid='topic-video']");
			if (video) {
				const topicId = video.getAttribute("data-topic-id");
				let last = 0;
				video.addEventListener("timeupdate", async () => {
					if (!video.duration) return;
					const pct = Math.min(100, Math.round((video.currentTime / video.duration) * 100));
					const pos = Math.floor(video.currentTime);
					if (pos - last < 15) return;
					last = pos;
					try {
						await fetch("/_emdash/api/plugins/lms-core/progress:tick", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-EmDash-Request": "1",
							},
							credentials: "same-origin",
							body: JSON.stringify({
								stepType: "topic",
								stepId: topicId,
								positionSeconds: pos,
								percentComplete: pct,
							}),
						});
					} catch {}
				});
			}

			const btn = document.querySelector("[data-testid='topic-complete-btn']");
			if (btn) {
				btn.addEventListener("click", async () => {
					btn.setAttribute("disabled", "true");
					btn.textContent = "Saving…";
					try {
						const res = await fetch("/_emdash/api/plugins/lms-core/progress:complete", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-EmDash-Request": "1",
							},
							credentials: "same-origin",
							body: JSON.stringify({
								stepType: "topic",
								stepId: btn.getAttribute("data-topic-id"),
							}),
						});
						if (!res.ok) {
							const text = await res.text();
							throw new Error(text || `Complete failed (${res.status})`);
						}
						btn.classList.add("done");
						btn.textContent = "Completed ✓";
					} catch (err) {
						btn.removeAttribute("disabled");
						btn.textContent = "Mark topic complete";
						alert("Mark complete failed: " + (err && err.message ? err.message : err));
					}
				});
			}
		</script>
	</body>
</html>
