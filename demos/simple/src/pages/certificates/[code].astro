---
import { callLmsRoute } from "../../lib/lms-api.ts";

interface VerificationResult {
	valid: boolean;
	issuedAt?: string;
	userName?: string;
	courseTitle?: string;
	revokedAt?: string;
	expiresAt?: string;
}

const { code } = Astro.params;
const cookie = Astro.request.headers.get("cookie");
const origin = Astro.url.origin;

const result = await callLmsRoute<VerificationResult>(
	"certificate:verify",
	{ code },
	{ cookie, origin },
);

const valid = result.ok && result.data?.valid === true;
const data = result.ok ? result.data : undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Certificate {code} — Emdash Learn demo</title>
		<style>
			body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 2rem auto; padding: 0 1rem; color: #111; }
			a { color: #1a4fff; }
			.banner { border-radius: 6px; padding: 1rem 1.25rem; font-size: 1.05rem; margin-block: 1rem; }
			.banner.valid { background: #dfe; color: #153; }
			.banner.invalid { background: #fee; color: #733; }
			.meta { color: #444; }
		</style>
	</head>
	<body>
		<nav><a href="/">← Home</a></nav>
		<h1>Certificate verification</h1>
		<p class="meta">Code: <code>{code}</code></p>

		{valid && data && (
			<div class="banner valid" data-testid="cert-valid">
				<strong>Valid certificate.</strong>
				<p>
					Issued to <strong>{data.userName ?? "—"}</strong> for{" "}
					<strong>{data.courseTitle ?? "—"}</strong>
					{data.issuedAt && <> on {new Date(data.issuedAt).toLocaleDateString()}</>}.
				</p>
				{data.expiresAt && (
					<p class="meta">Expires {new Date(data.expiresAt).toLocaleDateString()}.</p>
				)}
			</div>
		)}

		{!valid && (
			<div class="banner invalid" data-testid="cert-invalid">
				<strong>This certificate is not valid.</strong>
				{data?.revokedAt && (
					<p class="meta">Revoked {new Date(data.revokedAt).toLocaleDateString()}.</p>
				)}
				{!result.ok && (
					<p class="meta">Server: {result.error?.message ?? "unknown error"}</p>
				)}
			</div>
		)}
	</body>
</html>
